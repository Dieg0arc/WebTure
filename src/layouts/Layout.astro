---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonicalURL?: string;
  ogImage?: string;
}

const {
  title = "WebTure — Agencia web para negocios locales en Colombia",
  description = "Diseñamos y desarrollamos sitios web a la medida para negocios locales en Colombia. Rápidos, optimizados y pensados para convertir.",
  canonicalURL = "https://webture.co",
  ogImage = "https://webture.co/og-image.jpg",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="lenis">
  <head>
    <!-- Charset & Viewport -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Título y descripción -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Indexación -->
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Theme color (barra del navegador en mobile) -->
    <meta name="theme-color" content="#080808" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="WebTure" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/W.webp" />

    <!-- Google Fonts: non-blocking (preload + print trick) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style"
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=JetBrains+Mono:wght@400;500&display=swap"
      />
    </noscript>

    <!-- ─── GSAP desde jsDelivr CDN — defer mantiene orden y no bloquea parsing.
         Cada componente lee window.gsap dentro de sus funciones de init,
         nunca a nivel de módulo. Hero hace polling con rAF como fallback.
    ───────────────────────────────────────────────────────────────────── -->
    <script defer src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/gsap.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/ScrollTrigger.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/gsap@3.15.0/dist/SplitText.min.js"></script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <slot />

    <script>
      import '../scripts/lenis.js';
      import { initAll } from '../scripts/animations.js';

      // window.load garantiza que los scripts GSAP del <head> ya ejecutaron
      if (document.readyState === 'complete') {
        initAll();
      } else {
        window.addEventListener('load', initAll, { once: true });
      }
    </script>
  </body>
</html>
