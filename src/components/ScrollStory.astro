---
// ScrollStory.astro — Horizontal scroll con GSAP pin: true
// GSAP pin crea un pin-spacer y mueve el track con x en píxeles
// GSAP desde window.gsap (CDN) — nunca import npm
---

<section
  class="scrollstory"
  id="scrollstory"
  aria-label="Por qué necesitas una web profesional"
>
  <!-- Track horizontal — GSAP mueve esto con x -->
  <div class="ss-track">
    <!-- ── Capítulo 0: El problema ──────────────────────────────── -->
    <div class="ss-panel">
      <div class="wrap ss-inner">
        <div class="ss-text">
          <span class="ss-label">El problema</span>
          <h2 class="ss-title split-title">
            El <em class="accent-italic">73%</em> de tus clientes<br />
            te busca en Google primero.
          </h2>
          <p class="ss-body">
            Si no apareces, no existes. Cada día sin página web es un cliente
            que se va a la competencia que sí tiene presencia digital.
          </p>
        </div>
        <div class="ss-visual ss-visual--0">
          <div
            class="bar-chart"
            role="img"
            aria-label="Comparación: Sin web 12%, Plantilla gratis 31%, WebTure 92%"
          >
            <div class="bar-row">
              <span class="bar-label">Sin web</span>
              <div class="bar-wrap">
                <div class="bar-fill bar-fill--low"></div>
              </div>
              <span class="bar-pct">12%</span>
            </div>
            <div class="bar-row">
              <span class="bar-label">Plantilla gratis</span>
              <div class="bar-wrap">
                <div class="bar-fill bar-fill--mid"></div>
              </div>
              <span class="bar-pct">31%</span>
            </div>
            <div class="bar-row">
              <span class="bar-label">WebTure</span>
              <div class="bar-wrap">
                <div class="bar-fill bar-fill--high"></div>
              </div>
              <span class="bar-pct">92%</span>
            </div>
          </div>
          <p class="chart-caption">
            Tasa de conversión promedio por tipo de presencia web
          </p>
        </div>
      </div>
    </div>

    <!-- ── Capítulo 1: La solución ──────────────────────────────── -->
    <div class="ss-panel">
      <div class="wrap ss-inner">
        <div class="ss-text">
          <span class="ss-label">La solución</span>
          <h2 class="ss-title split-title">
            Tres pilares.<br />
            Un sitio que <em class="accent-italic">rinde.</em>
          </h2>
          <p class="ss-body">
            No vendemos páginas. Construimos herramientas de venta digitales que
            trabajan por tu negocio las 24 horas.
          </p>
        </div>
        <div class="ss-visual ss-visual--1">
          <div class="pillar-grid">
            <div class="pillar-card">
              <div class="pillar-icon">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                  ><path d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                >
              </div>
              <h3>Velocidad extrema</h3>
              <p>Core Web Vitals en verde. Carga en menos de 1.5&nbsp;s.</p>
            </div>
            <div class="pillar-card">
              <div class="pillar-icon">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                  ><path
                    d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"
                  ></path></svg
                >
              </div>
              <h3>Diseño que convierte</h3>
              <p>CTAs estratégicos. Cada elemento tiene un propósito.</p>
            </div>
            <div class="pillar-card">
              <div class="pillar-icon">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  aria-hidden="true"
                  ><rect x="5" y="2" width="14" height="20" rx="2"></rect><path
                    d="M12 18h.01"></path></svg
                >
              </div>
              <h3>100% Responsive</h3>
              <p>Perfecto en celular, tablet y escritorio. Siempre.</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Capítulo 2: El resultado ─────────────────────────────── -->
    <div class="ss-panel">
      <div class="wrap ss-inner">
        <div class="ss-text">
          <span class="ss-label">El resultado</span>
          <h2 class="ss-title split-title">
            De la idea al sitio<br />
            en <em class="accent-italic">4 días.</em>
          </h2>
          <p class="ss-body">
            Proceso claro, entregas puntuales, sin sorpresas. Tu negocio en
            línea esta semana.
          </p>
        </div>
        <div class="ss-visual ss-visual--2">
          <div class="timeline-mini">
            <div class="tm-item">
              <div class="tm-dot"></div>
              <div class="tm-content">
                <span class="tm-day">Día 01</span>
                <span class="tm-name">Briefing</span>
              </div>
            </div>
            <div class="tm-connector"></div>
            <div class="tm-item">
              <div class="tm-dot"></div>
              <div class="tm-content">
                <span class="tm-day">Día 02</span>
                <span class="tm-name">Diseño</span>
              </div>
            </div>
            <div class="tm-connector"></div>
            <div class="tm-item">
              <div class="tm-dot"></div>
              <div class="tm-content">
                <span class="tm-day">Día 03</span>
                <span class="tm-name">Desarrollo</span>
              </div>
            </div>
            <div class="tm-connector"></div>
            <div class="tm-item tm-item--accent">
              <div class="tm-dot"></div>
              <div class="tm-content">
                <span class="tm-day">Día 04</span>
                <span class="tm-name">
                  Lanzamiento
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="2"
                       stroke-linecap="round" stroke-linejoin="round"
                       aria-hidden="true"
                       style="display:inline-block;vertical-align:-2px;margin-left:4px">
                    <path d="M7 17L17 7M17 7H7M17 7v10"/>
                  </svg>
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div><!-- /ss-track -->
</section>

<style>
  /* ── Sección trigger ─────────────────────────────────────────────────────── */
  .scrollstory {
    background: var(--bg);
    overflow: hidden; /* Evita que el scroll horizontal rompa el diseño */
  }

  /* ── Track: paneles en fila, GSAP los mueve horizontalmente ────────────── */
  .ss-track {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap; /* Asegura que todos los paneles queden en una fila */
    width: max-content; /* Se adapta dinámicamente según la cantidad de paneles */
    height: 100svh;
    will-change: transform; /* Optimización GPU: aplicado solo al padre */
  }

  /* ── Cada panel ocupa 100vw ──────────────────────────────────────────────── */
  .ss-panel {
    width: 100vw;
    height: 100svh;
    display: flex;
    align-items: center;
    flex-shrink: 0; /* Evita que se encojan en el contenedor flex */
  }

  /* ── Grid interior ───────────────────────────────────────────────────────── */
  .ss-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
    width: 100%;
  }

  /* ── Texto ────────────────────────────────────────────────────────────────── */
  .ss-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }

  .ss-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.2vw, 60px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.04em;
    color: var(--text);
    margin-bottom: 20px;
  }

  .ss-body {
    font-size: 17px;
    color: var(--text-muted);
    line-height: 1.7;
    max-width: 420px;
  }

  /* ── Bar chart (capítulo 0) ──────────────────────────────────────────────── */
  .bar-chart {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
  }

  .bar-row {
    display: grid;
    grid-template-columns: 130px 1fr 48px;
    align-items: center;
    gap: 12px;
  }

  .bar-label {
    font-size: 13px;
    color: var(--text-muted);
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .bar-wrap {
    height: 36px;
    background: var(--surface-2);
    border-radius: 6px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .bar-fill {
    height: 100%;
    border-radius: 6px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .bar-fill--low {
    width: 12%;
    background: #ef4444;
  }
  .bar-fill--mid {
    width: 31%;
    background: #f97316;
  }
  .bar-fill--high {
    width: 92%;
    background: var(--accent);
  }

  .bar-pct {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--text);
    text-align: right;
  }

  .chart-caption {
    font-size: 12px;
    color: var(--text-dim);
    margin-top: 16px;
    font-family: var(--font-mono);
    line-height: 1.4;
  }

  /* ── Pillar cards (capítulo 1) ───────────────────────────────────────────── */
  .pillar-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .pillar-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 16px;
    transition:
      border-color 0.3s ease,
      transform 0.3s ease;
  }

  .pillar-card:hover {
    border-color: var(--accent-dim);
    transform: translateY(-2px);
  }

  .pillar-icon {
    width: 44px;
    height: 44px;
    background: var(--accent-glow-soft);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent);
    margin-bottom: 14px;
    flex-shrink: 0;
  }

  .pillar-card h3 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
    color: var(--text);
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .pillar-card p {
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* ── Timeline mini (capítulo 2) ──────────────────────────────────────────── */
  .timeline-mini {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .tm-item {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .tm-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--border-bright);
    border: 2px solid var(--border-bright);
    flex-shrink: 0;
    z-index: 1;
    transition:
      background 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .tm-item--accent .tm-dot {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: 0 0 16px var(--accent);
  }

  .tm-connector {
    width: 2px;
    height: 32px;
    background: var(--border);
    margin-left: 5px;
  }

  .tm-content {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .tm-day {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    display: block;
    letter-spacing: 0.08em;
  }

  .tm-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  /* ── Responsive ──────────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .ss-inner {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 60px;
    }

    .pillar-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .bar-row {
      grid-template-columns: 100px 1fr 40px;
      gap: 8px;
    }

    .ss-body {
      font-size: 15px;
      max-width: 100%;
    }
  }

  @media (max-width: 479px) {
    .bar-row {
      grid-template-columns: 80px 1fr 36px;
    }
    .bar-label {
      font-size: 11px;
    }
  }

  /* ── Mobile: vertical stack (replaces horizontal GSAP scroll) ────────────── */
  @media (max-width: 767px) {
    .scrollstory {
      overflow: visible;
    }

    .ss-track {
      flex-direction: column;
      width: 100%;
      will-change: auto;
      height: auto;
      transform: none !important;
    }

    .ss-panel {
      width: 100%;
      height: auto;
      padding: 64px 0 56px;
      flex-shrink: 1;
    }

    .ss-panel:not(:last-child) {
      border-bottom: 1px solid var(--border);
    }
  }

  /* ── prefers-reduced-motion ──────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .ss-track {
      flex-direction: column;
      width: 100%;
      will-change: auto;
    }

    .ss-panel {
      width: 100%;
      height: auto;
      min-height: 100svh;
    }

    .bar-fill {
      transform: scaleX(1);
      transition: none;
    }

    .pillar-card,
    .tm-dot {
      transition: none;
    }
  }
</style>

<script>
  if (typeof window !== "undefined") {
    const initScrollStory = () => {
      if (!window.gsap || !window.ScrollTrigger) return;

      const gsap = window.gsap;
      const ScrollTrigger = window.ScrollTrigger;

      const section = document.querySelector(".scrollstory");
      const track = document.querySelector(".ss-track");
      const prefersRed = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (!section || !track) return;

      // Mobile: vertical layout — animate bar fills on scroll, skip horizontal scroll
      if (window.innerWidth <= 767) {
        const barChart = section.querySelector('.bar-chart');
        if (!prefersRed && barChart) {
          ScrollTrigger.create({
            trigger: barChart,
            start: 'top 85%',
            once: true,
            onEnter: () => {
              gsap.utils.toArray('.bar-fill', section).forEach(bar => {
                bar.style.transform = 'scaleX(1)';
              });
            }
          });
        } else {
          gsap.utils.toArray('.bar-fill', section).forEach(bar => {
            bar.style.transform = 'scaleX(1)';
          });
        }
        return;
      }

      if (prefersRed) return;

      let ctx = gsap.context(() => {
        // Cálculo de Distancia Real
        const getScrollAmount = () => -(track.scrollWidth - window.innerWidth);

        // Optimización GPU: Animamos la caja padre entera (.ss-track), NO los paneles
        gsap.to(track, {
          x: getScrollAmount,
          ease: "none", // Movimiento lineal
          scrollTrigger: {
            trigger: section, // Contenedor envolvente
            start: "top top",
            // Pin dura exactamente la cantidad que nos movemos (ratio 1:1)
            end: () => `+=${track.scrollWidth - window.innerWidth}`,
            pin: true,
            scrub: 1, // Fluididad total
            invalidateOnRefresh: true, // Recalcula si el usuario rota o redimensiona pantalla
          },
        });

        // Gráfico de barras
        ScrollTrigger.create({
          trigger: section,
          start: "top 80%",
          once: true,
          onEnter: () => {
            gsap.utils.toArray(".bar-fill", section).forEach((bar) => {
              bar.style.transform = "scaleX(1)";
            });
          },
        });
      }, section);

      // Accesibilidad & Limpieza: Si usaras Astro View Transitions, ctx.revert() previene fugas de memoria
      document.addEventListener("astro:before-swap", () => ctx.revert(), { once: true });
    };

    // Usamos `load` para garantizar que GSAP (defer) ya está disponible
    if (document.readyState === 'complete') {
      initScrollStory();
    } else {
      window.addEventListener('load', initScrollStory, { once: true });
    }
  }
</script>
