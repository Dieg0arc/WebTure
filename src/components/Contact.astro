---
const stats = [
  { value: "< 24h",  label: "respuesta" },
  { value: "4 días", label: "entrega"   },
  { value: "100%",   label: "responsive"},
];
---

<section id="contacto" class="contact" aria-label="Contacto">
  <div class="wrap">
    <div class="contact-inner">

      <!-- Texto principal -->
      <div class="contact-text">
        <h2 class="contact-title split-title">
          Hablemos de tu sitio<br>esta semana.
        </h2>
        <p class="contact-sub">Sin formularios. Sin esperas. Solo escríbeme.</p>
      </div>

      <!-- Acciones -->
      <div class="contact-actions">
        <div class="wa-wrapper">
          <a
            href="https://wa.me/573046565684?text=Hola%2C%20quiero%20hablar%20sobre%20mi%20sitio%20web"
            class="btn-wa"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Escribir por WhatsApp a WebTure"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Escribir por WhatsApp
          </a>
        </div>

        <a href="mailto:hola@webture.co" class="contact-email">
          hola@webture.co
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <!-- Trust stats -->
      <div class="trust-bar" aria-label="Por qué elegirnos">
        {stats.map((s, i) => (
          <>
            <div class="trust-stat">
              <span class="trust-val">{s.value}</span>
              <span class="trust-lbl">{s.label}</span>
            </div>
            {i < stats.length - 1 && (
              <div class="trust-sep" aria-hidden="true"></div>
            )}
          </>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  /* ─── Sección ────────────────────────────────────────────────────────────── */
  .contact {
    padding: 140px 0 160px;
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-radius: 24px 24px 0 0;
    box-shadow: 0 -28px 72px rgba(0, 0, 0, 0.55);
  }

  .contact::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(600px, 80%);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-bright), transparent);
  }

  /* Orbe ambiental decorativo */
  .contact::after {
    content: "";
    position: absolute;
    bottom: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: min(600px, 100%); /* Capped to parent — 600px fijo desbordaría en mobile */
    height: 400px;
    background: radial-gradient(ellipse, rgba(179,136,255,0.06) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* ─── Inner centrado ─────────────────────────────────────────────────────── */
  .contact-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 52px;
    position: relative;
    z-index: 1;
  }

  /* ─── Texto ──────────────────────────────────────────────────────────────── */
  .contact-title {
    font-family: var(--font-display);
    font-size: clamp(36px, 5.5vw, 68px);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.04em;
    color: var(--text);
    margin-bottom: 20px;
  }

  .contact-sub {
    font-size: 18px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* ─── Acciones ───────────────────────────────────────────────────────────── */
  .contact-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  /* WhatsApp button con pulse */
  .wa-wrapper {
    position: relative;
    display: inline-flex;
  }

  .wa-wrapper::before,
  .wa-wrapper::after {
    content: "";
    position: absolute;
    inset: -5px;
    border-radius: 18px;
    border: 1px solid var(--accent);
    animation: wa-pulse 2.4s ease-out infinite;
    pointer-events: none;
  }

  .wa-wrapper::after {
    animation-delay: 1.2s;
  }

  @keyframes wa-pulse {
    0%   { opacity: 0.55; transform: scale(1); }
    100% { opacity: 0;    transform: scale(1.2); }
  }

  .btn-wa {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 40px;
    background: #25D366;
    color: #000;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 17px;
    border-radius: 16px;
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    position: relative;
    z-index: 1;
    white-space: nowrap;
  }

  @media (hover: hover) {
    .btn-wa:hover {
      background: color-mix(in srgb, #25D366 80%, #000);
      transform: translateY(-2px);
      box-shadow: 0 12px 40px rgba(37,211,102,0.3);
    }
  }

  .btn-wa:active {
    transform: translateY(0);
  }

  .contact-email {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 15px;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  @media (hover: hover) {
    .contact-email:hover {
      color: var(--accent);
    }
  }

  /* ─── Trust bar ──────────────────────────────────────────────────────────── */
  .trust-bar {
    display: flex;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .trust-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 22px 40px;
  }

  .trust-val {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .trust-lbl {
    font-size: 11px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .trust-sep {
    width: 1px;
    height: 44px;
    background: var(--border);
    flex-shrink: 0;
  }

  /* ─── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .contact {
      padding: 100px 0 120px;
      position: relative;
      border-radius: 0;
      box-shadow: none;
      overflow-x: clip; /* Clip decorative pseudo-elements that extend beyond 390px */
    }

    .contact-inner {
      gap: 40px;
    }

    .contact-title {
      font-size: clamp(30px, 9vw, 48px);
    }

    .trust-bar {
      flex-direction: column;
      width: 100%;
      max-width: 280px;
    }

    .trust-sep {
      width: 40px;
      height: 1px;
    }

    .trust-stat {
      padding: 18px 32px;
    }
  }

  @media (max-width: 479px) {
    .btn-wa {
      font-size: 15px;
      padding: 16px 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-wrapper::before,
    .wa-wrapper::after {
      animation: none;
    }

    .btn-wa,
    .contact-email {
      transition: none;
    }
  }
</style>

<script type="module">

  function initContact() {
    const gsap          = window.gsap;
    const ScrollTrigger = window.ScrollTrigger;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (!gsap || !ScrollTrigger || prefersReduced) return;

    const tl = gsap.timeline({
      scrollTrigger: { trigger: '.contact', start: 'top 75%', once: true },
    });

    tl.fromTo('.contact-title', { opacity: 0, y: 32 }, {
      opacity: 1, y: 0, duration: 0.7, ease: 'power3.out',
    });

    tl.fromTo('.contact-sub', { opacity: 0, y: 20 }, {
      opacity: 1, y: 0, duration: 0.5, ease: 'power2.out',
    }, '-=0.4');

    tl.fromTo('.contact-actions', { opacity: 0, y: 24 }, {
      opacity: 1, y: 0, duration: 0.6, ease: 'power3.out',
    }, '-=0.3');

    tl.fromTo('.trust-bar', { opacity: 0, y: 20 }, {
      opacity: 1, y: 0, duration: 0.5, ease: 'power2.out',
    }, '-=0.3');
  }

  if (document.readyState === 'complete') {
    initContact();
  } else {
    window.addEventListener('load', initContact, { once: true });
  }
</script>
