---
const WA_URL =
  "https://wa.me/573046565684?text=Hola%2C%20quiero%20una%20cotizaci%C3%B3n%20para%20mi%20sitio%20web";
---

<section class="hero" id="inicio">
  <!-- Capa 1: Orbes de luz (simula WebGL glow) -->
  <div class="hero-mesh" aria-hidden="true">
    <div class="mesh-orb mesh-orb--1"></div>
    <div class="mesh-orb mesh-orb--2"></div>
    <div class="mesh-orb mesh-orb--3"></div>
  </div>

  <!-- Capa 2: Grid tecnológico de fondo -->
  <div class="hero-grid" aria-hidden="true"></div>

  <!-- Capa 3: Partículas — canvas sobre el grid, detrás del contenido -->
  <canvas class="hero-particles" aria-hidden="true"></canvas>

  <!-- Capa 4: Contenido -->
  <div class="wrap hero-inner">
    <div class="hero-content">
      <!-- Eyebrow badge -->
      <div class="hero-eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>Agencia web · Colombia · Disponible ahora</span>
      </div>

      <!-- Título principal -->
      <h1 class="hero-h1">
        Tu negocio merece<br />
        una web que <em class="accent-italic">venda.</em>
      </h1>

      <!-- Subtítulo -->
      <p class="hero-sub">
        Diseñamos y desarrollamos sitios web para negocios locales en Colombia.
        Rápidos, modernos y optimizados para aparecer primero en Google.
      </p>

      <!-- CTAs -->
      <div class="cta-row">
        <a
          href={WA_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary cta-wa"
          aria-label="Cotiza gratis por WhatsApp"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
            ></path>
            <path
              d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.122 1.528 5.858L0 24l6.335-1.652A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.372l-.36-.214-3.732.979.994-3.642-.234-.374A9.818 9.818 0 1112 21.818z"
            ></path>
          </svg>
          Cotiza gratis por WhatsApp
        </a>

        <a href="#proyectos" class="btn-ghost cta-projects">
          Ver proyectos
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <!-- Trust strip — solo visible en mobile, da peso visual bajo los CTAs -->
      <div class="hero-trust" aria-label="Estadísticas clave">
        <div class="ht-stat">
          <span class="ht-num">47+</span>
          <span class="ht-label">Proyectos</span>
        </div>
        <div class="ht-sep" aria-hidden="true"></div>
        <div class="ht-stat">
          <span class="ht-num">4 días</span>
          <span class="ht-label">Entrega</span>
        </div>
        <div class="ht-sep" aria-hidden="true"></div>
        <div class="ht-stat">
          <span class="ht-num">98%</span>
          <span class="ht-label">Satisfacción</span>
        </div>
      </div>
    </div>

    <!-- Stats strip — desktop -->
    <div class="hero-stats" aria-label="Estadísticas clave">
      <div class="hstat">
        <span class="hstat-num">47+</span>
        <span class="hstat-label">Proyectos entregados</span>
      </div>
      <div class="hstat-sep" aria-hidden="true"></div>
      <div class="hstat">
        <span class="hstat-num">4 días</span>
        <span class="hstat-label">Tiempo de entrega</span>
      </div>
      <div class="hstat-sep" aria-hidden="true"></div>
      <div class="hstat">
        <span class="hstat-num">98%</span>
        <span class="hstat-label">Clientes satisfechos</span>
      </div>
    </div>
  </div>

</section>

<style>
  /* ─── Hero base ──────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding-top: 80px;
  }

  /* ─── Mesh / orbes de fondo ──────────────────────────────────────────────── */
  .hero-mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .mesh-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.15;
  }

  .mesh-orb--1 {
    width: 600px;
    height: 600px;
    background: var(--accent);
    top: -200px;
    left: -100px;
    opacity: 0.2;
    animation: orbFloat1 12s ease-in-out infinite;
  }

  .mesh-orb--2 {
    width: 400px;
    height: 400px;
    background: var(--accent-dim);
    bottom: -100px;
    right: 10%;
    animation: orbFloat2 15s ease-in-out infinite reverse;
  }

  .mesh-orb--3 {
    width: 300px;
    height: 300px;
    background: var(--accent);
    top: 40%;
    left: 50%;
    opacity: 0.06;
    animation: orbFloat1 18s ease-in-out infinite 3s;
  }

  @keyframes orbFloat1 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    33% {
      transform: translate(30px, -40px);
    }
    66% {
      transform: translate(-20px, 20px);
    }
  }

  @keyframes orbFloat2 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-30px, -30px);
    }
  }

  /* ─── Grid de fondo ──────────────────────────────────────────────────────── */
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(179, 136, 255, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(179, 136, 255, 0.05) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(
      ellipse 80% 80% at 50% 50%,
      black 30%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 80% 80% at 50% 50%,
      black 30%,
      transparent 100%
    );
  }

  /* ─── Canvas de partículas ──────────────────────────────────────────────── */
  .hero-particles {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    animation: particlesFadeIn 2s ease-out 0.6s forwards;
  }

  @keyframes particlesFadeIn {
    to {
      opacity: 1;
    }
  }

  /* ─── Hero inner layout ──────────────────────────────────────────────────── */
  .hero-inner {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 80px 0 80px;
    text-align: center;
  }

  /* ─── Contenido textual ──────────────────────────────────────────────────── */
  .hero-content {
    max-width: 860px;
    width: 100%;
  }

  /* ─── Eyebrow badge ──────────────────────────────────────────────────────── */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(179, 136, 255, 0.08);
    border: 1px solid rgba(179, 136, 255, 0.2);
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 32px;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-success);
    flex-shrink: 0;
    box-shadow: 0 0 8px var(--color-success);
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.8);
    }
  }

  /* ─── H1 ─────────────────────────────────────────────────────────────────── */
  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(44px, 5.5vw, 80px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.05em;
    color: var(--text);
    margin-bottom: 28px;
  }

  /* ─── Subtítulo ──────────────────────────────────────────────────────────── */
  .hero-sub {
    font-size: clamp(16px, 1.6vw, 20px);
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 48px;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ─── CTA row ────────────────────────────────────────────────────────────── */
  .cta-row {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .cta-wa,
  .cta-projects {
    display: inline-flex;
    align-items: center;
  }

  .cta-wa {
    gap: 10px;
  }

  .cta-projects {
    gap: 8px;
  }

  /* ─── Stats strip (desktop) ─────────────────────────────────────────────── */
  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin-top: 72px;
    padding: 24px 48px;
    background: rgba(179, 136, 255, 0.04);
    border: 1px solid rgba(179, 136, 255, 0.12);
    border-radius: var(--radius-lg);
  }

  .hstat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 0 48px;
  }

  .hstat-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 3vw, 40px);
    letter-spacing: -0.04em;
    line-height: 1;
    background: linear-gradient(135deg, #b388ff 0%, #e0cfff 60%, #f5eeff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hstat-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hstat-sep {
    width: 1px;
    height: 44px;
    background: rgba(179, 136, 255, 0.15);
    flex-shrink: 0;
  }

  /* ─── Trust strip (mobile only) ─────────────────────────────────────────── */
  .hero-trust {
    display: none;
  }

  .ht-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .ht-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: -0.03em;
    line-height: 1;
    background: linear-gradient(120deg, #b388ff 0%, #d4b8ff 55%, #f0e6ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .ht-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    text-align: center;
  }

  .ht-sep {
    width: 1px;
    height: 36px;
    background: rgba(179, 136, 255, 0.18);
    flex-shrink: 0;
  }

  /* ─── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .hero-inner {
      padding: 60px 0 40px;
    }

    .hero-h1 {
      letter-spacing: -0.03em;
    }

    .hero-eyebrow {
      white-space: normal;
      text-align: center;
    }

    .hero-stats {
      display: none;
    }

    .hero-particles {
      display: none;
    }

    .mesh-orb--2,
    .mesh-orb--3 {
      display: none;
    }

    .mesh-orb--1 {
      width: 300px;
      height: 300px;
      filter: blur(60px);
      animation: none;
      opacity: 0.14;
    }

    /* Trust strip visible en mobile */
    .hero-trust {
      display: flex;
      align-items: center;
      margin-top: 40px;
      background: rgba(179, 136, 255, 0.05);
      border: 1px solid rgba(179, 136, 255, 0.14);
      border-radius: var(--radius);
      overflow: hidden;
    }

    .ht-stat {
      flex: 1;
      padding: 18px 10px;
    }
  }

  @media (max-width: 479px) {
    .cta-row {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-primary,
    .btn-ghost {
      text-align: center;
      justify-content: center;
    }

    .hero-eyebrow {
      font-size: 11px;
      white-space: normal;
      text-align: center;
    }
  }

  /* ─── Reduced motion ─────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .mesh-orb,
    .eyebrow-dot,
    .hero-particles {
      animation: none !important;
    }
  }
</style>

<script type="module">
  function initHero() {
    const gsap = window.gsap;
    const ScrollTrigger = window.ScrollTrigger;
    if (!gsap || !ScrollTrigger) return;

    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!prefersReduced) {
      /* ── Animación de entrada ─────────────────────────────────────────── */
      const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

      tl.from(".hero-eyebrow", { y: 20, opacity: 0, duration: 0.7 })
        .from(".hero-h1", { y: 40, opacity: 0, duration: 0.8 }, "-=0.4")
        .from(".hero-sub", { y: 30, opacity: 0, duration: 0.7 }, "-=0.5")
        .from(".cta-row", { y: 20, opacity: 0, duration: 0.6 }, "-=0.4")
        .from(".hero-stats", { y: 24, opacity: 0, duration: 0.7 }, "-=0.3");

      /* ── Parallax multicapa al scroll — solo en dispositivos no-touch ── */
      if (!window.matchMedia('(pointer: coarse)').matches) {
        const heroTl = gsap.timeline({
          scrollTrigger: {
            trigger: ".hero",
            start: "top top",
            end: "80% top",
            scrub: 1.5,
          },
        });

        heroTl
          .to(".hero-eyebrow", { y: -50, opacity: 0, duration: 1 }, 0)
          .to(".hero-h1", { y: -100, scale: 0.97, duration: 1 }, 0)
          .to(".hero-sub", { y: -70, opacity: 0, duration: 1 }, 0)
          .to(".cta-row", { y: -40, opacity: 0, duration: 1 }, 0)
          .to(".hero-stats", { y: -20, opacity: 0, duration: 1 }, 0)
          .to(".mesh-orb--1", { y: -80, duration: 1 }, 0)
          .to(".mesh-orb--2", { y: 60, duration: 1 }, 0);
      }
    }
  }

  if (document.readyState === "complete") {
    initHero();
  } else {
    window.addEventListener("load", initHero, { once: true });
  }
</script>

<script type="module">
  /* ── Constelación de partículas ─────────────────────────────────────────── */
  (function initParticles() {
    if (typeof window === "undefined") return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia("(max-width: 767px)").matches) return;

    const canvas = document.querySelector(".hero-particles");
    if (!canvas) return;

    const ctx = canvas.getContext("2d");
    const hero = document.querySelector(".hero");

    let W = 0, H = 0;

    function resize() {
      W = canvas.width = hero.offsetWidth;
      H = canvas.height = hero.offsetHeight;
    }
    resize();

    const ro = new ResizeObserver(resize);
    ro.observe(hero);

    /* Partículas */
    const COUNT = 70;
    const MAX_DIST = 135;
    const MAX_DIST_SQ = MAX_DIST * MAX_DIST;
    const R = 179, G = 136, B = 255; /* --accent RGB */

    const pts = Array.from({ length: COUNT }, () => ({
      x:  Math.random() * W,
      y:  Math.random() * H,
      vx: (Math.random() - 0.5) * 0.38,
      vy: (Math.random() - 0.5) * 0.38,
      r:  Math.random() * 1.3 + 0.4,
    }));

    let raf;

    function tick() {
      ctx.clearRect(0, 0, W, H);

      /* Mover */
      for (const p of pts) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < -2)    p.x = W + 2;
        else if (p.x > W + 2) p.x = -2;
        if (p.y < -2)    p.y = H + 2;
        else if (p.y > H + 2) p.y = -2;
      }

      /* Conexiones */
      for (let i = 0; i < COUNT; i++) {
        for (let j = i + 1; j < COUNT; j++) {
          const dx = pts[i].x - pts[j].x;
          const dy = pts[i].y - pts[j].y;
          const dSq = dx * dx + dy * dy;
          if (dSq < MAX_DIST_SQ) {
            const alpha = (1 - dSq / MAX_DIST_SQ) * 0.13;
            ctx.beginPath();
            ctx.strokeStyle = `rgba(${R},${G},${B},${alpha.toFixed(3)})`;
            ctx.lineWidth = 0.65;
            ctx.moveTo(pts[i].x, pts[i].y);
            ctx.lineTo(pts[j].x, pts[j].y);
            ctx.stroke();
          }
        }
      }

      /* Puntos */
      for (const p of pts) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${R},${G},${B},0.4)`;
        ctx.fill();
      }

      raf = requestAnimationFrame(tick);
    }

    tick();
  })();
</script>
