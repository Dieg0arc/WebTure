---
const WA_URL =
  "https://wa.me/573046565684?text=Hola%2C%20quiero%20una%20cotizaci%C3%B3n%20para%20mi%20sitio%20web";
---

<section class="hero" id="inicio">
  <!-- Capa 1: Orbes de luz (simula WebGL glow) -->
  <div class="hero-mesh" aria-hidden="true">
    <div class="mesh-orb mesh-orb--1"></div>
    <div class="mesh-orb mesh-orb--2"></div>
    <div class="mesh-orb mesh-orb--3"></div>
  </div>

  <!-- Capa 2: Grid tecnológico de fondo -->
  <div class="hero-grid" aria-hidden="true"></div>

  <!-- Capa 3: Contenido -->
  <div class="wrap hero-inner">
    <div class="hero-content">
      <!-- Eyebrow badge -->
      <div class="hero-eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        <span>Agencia web · Colombia · Disponible ahora</span>
      </div>

      <!-- Título principal -->
      <h1 class="hero-h1">
        Tu negocio merece<br />
        una web que <em class="accent-italic">venda.</em>
      </h1>

      <!-- Subtítulo -->
      <p class="hero-sub">
        Diseñamos y desarrollamos sitios web para negocios locales en Colombia.
        Rápidos, modernos y optimizados para aparecer primero en Google.
      </p>

      <!-- CTAs -->
      <div class="cta-row">
        <a
          href={WA_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary cta-wa"
          aria-label="Cotiza gratis por WhatsApp"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
            ></path>
            <path
              d="M12 0C5.373 0 0 5.373 0 12c0 2.124.558 4.122 1.528 5.858L0 24l6.335-1.652A11.954 11.954 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.006-1.372l-.36-.214-3.732.979.994-3.642-.234-.374A9.818 9.818 0 1112 21.818z"
            ></path>
          </svg>
          Cotiza gratis por WhatsApp
        </a>

        <a href="#proyectos" class="btn-ghost cta-projects">
          Ver proyectos
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path d="M5 12h14M12 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Tarjeta decorativa desktop -->
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-card">
        <!-- Barra macOS -->
        <div class="hcard-bar">
          <span class="hcb-dot" style="background: #ff5f57"></span>
          <span class="hcb-dot" style="background: #febc2e"></span>
          <span class="hcb-dot" style="background: #28c840"></span>
        </div>

        <!-- URL bar -->
        <div class="hcard-content">
          <div class="hcard-dot"></div>
          <span>webture.co</span>
        </div>

        <!-- Líneas de código simuladas -->
        <div class="hcard-lines">
          <div class="hcard-line" style="width: 85%"></div>
          <div class="hcard-line" style="width: 60%"></div>
          <div class="hcard-line" style="width: 72%"></div>
          <div class="hcard-line" style="width: 45%"></div>
          <div class="hcard-line" style="width: 90%"></div>
          <div class="hcard-line" style="width: 55%"></div>
        </div>

        <!-- Score de performance -->
        <div class="hcard-score">
          <div>
            <span class="score-num">98</span>
            <span class="score-label">Performance</span>
          </div>
          <div class="score-badge">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#4ade80"
              stroke-width="2.5"
            >
              <path d="M20 6L9 17l-5-5"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Marquee inferior -->
  <div class="hero-marquee" aria-hidden="true">
    <div class="marquee-track">
      <span>WEBTURE</span><span class="sep">·</span>
      <span>DISEÑO</span><span class="sep">·</span>
      <span>CONVERSIÓN</span><span class="sep">·</span>
      <span>COLOMBIA</span><span class="sep">·</span>
      <span>SEO</span><span class="sep">·</span>
      <span>VELOCIDAD</span><span class="sep">·</span>
      <span>RESULTADOS</span><span class="sep">·</span>
      <!-- Duplicado exacto para loop sin salto -->
      <span>WEBTURE</span><span class="sep">·</span>
      <span>DISEÑO</span><span class="sep">·</span>
      <span>CONVERSIÓN</span><span class="sep">·</span>
      <span>COLOMBIA</span><span class="sep">·</span>
      <span>SEO</span><span class="sep">·</span>
      <span>VELOCIDAD</span><span class="sep">·</span>
      <span>RESULTADOS</span><span class="sep">·</span>
    </div>
  </div>
</section>

<style>
  /* ─── Hero base ──────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    padding-top: 80px;
  }

  /* ─── Mesh / orbes de fondo ──────────────────────────────────────────────── */
  .hero-mesh {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .mesh-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.15;
  }

  .mesh-orb--1 {
    width: 600px;
    height: 600px;
    background: var(--accent);
    top: -200px;
    left: -100px;
    animation: orbFloat1 12s ease-in-out infinite;
  }

  .mesh-orb--2 {
    width: 400px;
    height: 400px;
    background: #7e57c2;
    bottom: -100px;
    right: 10%;
    animation: orbFloat2 15s ease-in-out infinite reverse;
  }

  .mesh-orb--3 {
    width: 300px;
    height: 300px;
    background: var(--accent);
    top: 40%;
    left: 50%;
    opacity: 0.08;
    animation: orbFloat1 18s ease-in-out infinite 3s;
  }

  @keyframes orbFloat1 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    33% {
      transform: translate(30px, -40px);
    }
    66% {
      transform: translate(-20px, 20px);
    }
  }

  @keyframes orbFloat2 {
    0%,
    100% {
      transform: translate(0, 0);
    }
    50% {
      transform: translate(-30px, -30px);
    }
  }

  /* ─── Grid de fondo ──────────────────────────────────────────────────────── */
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(179, 136, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(179, 136, 255, 0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(
      ellipse 80% 80% at 50% 50%,
      black 30%,
      transparent 100%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 80% 80% at 50% 50%,
      black 30%,
      transparent 100%
    );
  }

  /* ─── Hero inner layout ──────────────────────────────────────────────────── */
  .hero-inner {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
    padding: 80px 0 60px;
  }

  /* ─── Contenido textual ──────────────────────────────────────────────────── */
  .hero-content {
    max-width: 640px;
    flex-shrink: 0;
  }

  /* ─── Eyebrow badge ──────────────────────────────────────────────────────── */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(179, 136, 255, 0.08);
    border: 1px solid rgba(179, 136, 255, 0.2);
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 28px;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .eyebrow-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #4ade80;
    flex-shrink: 0;
    box-shadow: 0 0 8px #4ade80;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.8);
    }
  }

  /* ─── H1 ─────────────────────────────────────────────────────────────────── */
  .hero-h1 {
    font-family: var(--font-display);
    font-size: clamp(42px, 6.5vw, 96px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--text);
    margin-bottom: 24px;
  }

  .accent-italic {
    color: var(--accent);
    font-style: italic;
    font-weight: 800;
  }

  /* ─── Subtítulo ──────────────────────────────────────────────────────────── */
  .hero-sub {
    font-size: clamp(16px, 1.8vw, 20px);
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 40px;
    max-width: 520px;
  }

  /* ─── CTA row ────────────────────────────────────────────────────────────── */
  .cta-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .cta-wa,
  .cta-projects {
    display: inline-flex;
    align-items: center;
  }

  .cta-wa {
    gap: 10px;
  }

  .cta-projects {
    gap: 8px;
  }

  /* ─── Visual decorativo (desktop) ───────────────────────────────────────── */
  .hero-visual {
    width: 380px;
    flex-shrink: 0;
  }

  .hero-card {
    background: var(--surface);
    border: 1px solid var(--border-bright);
    border-radius: var(--radius-lg);
    overflow: hidden;
    padding-bottom: 20px;
    box-shadow:
      0 0 0 1px rgba(179, 136, 255, 0.05),
      0 40px 80px rgba(0, 0, 0, 0.4),
      0 0 80px rgba(179, 136, 255, 0.06);
  }

  /* Barra macOS */
  .hcard-bar {
    height: 36px;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 12px;
  }

  .hcb-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* URL bar */
  .hcard-content {
    padding: 16px 20px 0;
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
  }

  .hcard-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  /* Líneas de código simuladas */
  .hcard-lines {
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .hcard-line {
    height: 10px;
    background: var(--border-bright);
    border-radius: 100px;
    animation: shimmer 2.5s ease-in-out infinite;
  }

  .hcard-line:nth-child(1) {
    animation-delay: 0s;
  }
  .hcard-line:nth-child(2) {
    animation-delay: 0.2s;
  }
  .hcard-line:nth-child(3) {
    animation-delay: 0.4s;
  }
  .hcard-line:nth-child(4) {
    animation-delay: 0.6s;
  }
  .hcard-line:nth-child(5) {
    animation-delay: 0.8s;
  }
  .hcard-line:nth-child(6) {
    animation-delay: 1s;
  }

  @keyframes shimmer {
    0%,
    100% {
      opacity: 0.4;
    }
    50% {
      opacity: 0.8;
    }
  }

  /* Score */
  .hcard-score {
    margin: 8px 20px 0;
    padding: 14px 16px;
    background: rgba(179, 136, 255, 0.08);
    border: 1px solid rgba(179, 136, 255, 0.2);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hcard-score > div {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .score-num {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 800;
    color: var(--accent);
    line-height: 1;
  }

  .score-label {
    font-size: 13px;
    color: var(--text-muted);
  }

  .score-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: rgba(74, 222, 128, 0.1);
    border: 1px solid rgba(74, 222, 128, 0.2);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ─── Marquee ────────────────────────────────────────────────────────────── */
  .hero-marquee {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--border);
    padding: 16px 0;
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  .marquee-track {
    display: flex;
    align-items: center;
    gap: 32px;
    width: max-content;
    animation: marquee 38s linear infinite;
  }

  .marquee-track span {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--text-dim);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .marquee-track .sep {
    color: var(--accent);
    opacity: 0.4;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* ─── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 959px) {
    .hero-visual {
      display: none;
    }

    .hero-inner {
      justify-content: center;
    }

    .hero-content {
      max-width: 100%;
      text-align: center;
    }

    .hero-eyebrow {
      justify-content: center;
    }

    .hero-sub {
      max-width: 100%;
      margin-left: auto;
      margin-right: auto;
    }

    .cta-row {
      justify-content: center;
    }
  }

  @media (max-width: 767px) {
    .hero-inner {
      padding: 60px 0 40px;
    }

    .hero-h1 {
      letter-spacing: -0.03em;
    }
  }

  @media (max-width: 479px) {
    .cta-row {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-primary,
    .btn-ghost {
      text-align: center;
      justify-content: center;
    }

    .hero-eyebrow {
      font-size: 11px;
      white-space: normal;
      text-align: center;
    }
  }

  /* ─── Reduced motion ─────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .mesh-orb,
    .hcard-line,
    .eyebrow-dot,
    .marquee-track {
      animation: none !important;
    }

    .marquee-track {
      /* Muestra el contenido estático cuando no hay animación */
      overflow: hidden;
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
      gap: 16px;
    }
  }
</style>

<script type="module">
  if (typeof window === "undefined") return;

  function initHero() {
    const gsap = window.gsap;
    const ScrollTrigger = window.ScrollTrigger;

    if (!gsap || !ScrollTrigger) {
      requestAnimationFrame(initHero);
      return;
    }

    gsap.registerPlugin(ScrollTrigger);

    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (!prefersReduced) {
      /* ── Animación de entrada ─────────────────────────────────────────── */
      const tl = gsap.timeline({ defaults: { ease: "power3.out" } });

      tl.from(".hero-eyebrow", { y: 20, opacity: 0, duration: 0.7 })
        .from(".hero-h1", { y: 40, opacity: 0, duration: 0.8 }, "-=0.4")
        .from(".hero-sub", { y: 30, opacity: 0, duration: 0.7 }, "-=0.5")
        .from(".cta-row", { y: 20, opacity: 0, duration: 0.6 }, "-=0.4")
        .from(".hero-visual", { x: 40, opacity: 0, duration: 0.9 }, "-=0.6")
        .from(".hero-marquee", { opacity: 0, duration: 0.5 }, "-=0.3");

      /* ── Parallax multicapa al scroll ────────────────────────────────── */
      const heroTl = gsap.timeline({
        scrollTrigger: {
          trigger: ".hero",
          start: "top top",
          end: "80% top",
          scrub: 1.5,
        },
      });

      heroTl
        .to(".hero-eyebrow", { y: -50, opacity: 0, duration: 1 }, 0)
        .to(".hero-h1", { y: -100, scale: 0.97, duration: 1 }, 0)
        .to(".hero-sub", { y: -70, opacity: 0, duration: 1 }, 0)
        .to(".cta-row", { y: -40, opacity: 0, duration: 1 }, 0)
        .to(".hero-visual", { y: -40, opacity: 0, duration: 1 }, 0)
        .to(".mesh-orb--1", { y: -80, duration: 1 }, 0)
        .to(".mesh-orb--2", { y: 60, duration: 1 }, 0);
    }
  }

  initHero();
</script>
