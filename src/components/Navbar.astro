---
const WA_URL =
  'https://wa.me/573046565684?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20WebTure';
---

<nav id="nav">
  <div class="nav-inner wrap">

    <!-- Logo -->
    <a href="#inicio" class="nav-logo">
      WebTure<span class="logo-dot">.</span>
    </a>

    <!-- Links desktop -->
    <ul class="nav-links" role="list">
      <li><a href="#inicio">Inicio</a></li>
      <li><a href="#proyectos">Proyectos</a></li>
      <li><a href="#servicios">Servicios</a></li>
      <li><a href="#proceso">Proceso</a></li>
      <li><a href="#precios">Precios</a></li>
      <li><a href="#contacto">Contacto</a></li>
    </ul>

    <!-- Acciones -->
    <div class="nav-actions">
      <a
        href={WA_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-cta"
        aria-label="Contáctanos por WhatsApp"
      >
        Hablemos
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path
            d="M1 11L11 1M11 1H4M11 1V8"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>

      <button
        class="nav-burger"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="navMobile"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</nav>

<!-- Menú mobile — fuera de <nav> para evitar stacking context por backdrop-filter -->
<div class="nav-mobile" id="navMobile" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Menú de navegación" inert>
  <ul role="list">
    <li><a href="#inicio"    class="mobile-link">Inicio</a></li>
    <li><a href="#proyectos" class="mobile-link">Proyectos</a></li>
    <li><a href="#servicios" class="mobile-link">Servicios</a></li>
    <li><a href="#proceso"   class="mobile-link">Proceso</a></li>
    <li><a href="#precios"   class="mobile-link">Precios</a></li>
    <li><a href="#contacto"  class="mobile-link">Contacto</a></li>
  </ul>
  <a
    href={WA_URL}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-primary mobile-cta"
  >
    Hablemos
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2"
         stroke-linecap="round" stroke-linejoin="round"
         aria-hidden="true">
      <path d="M7 17L17 7M17 7H7M17 7v10"/>
    </svg>
  </a>
</div>

<style>
  /* ─── Base nav ──────────────────────────────────────────────────────────── */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 20px 0;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background    0.4s ease,
      border-color  0.4s ease,
      padding       0.4s ease,
      backdrop-filter 0.4s ease;
  }

  nav.scrolled {
    background: rgba(8, 8, 8, 0.85);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid var(--border);
    padding: 14px 0;
  }

  /* ─── Inner layout ──────────────────────────────────────────────────────── */
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  /* ─── Logo ──────────────────────────────────────────────────────────────── */
  .nav-logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    color: var(--text);
    letter-spacing: -0.03em;
    text-decoration: none;
    flex-shrink: 0;
    transition: opacity 0.2s ease;
  }
  .nav-logo:hover {
    opacity: 0.85;
  }

  .logo-dot {
    color: var(--accent);
  }

  /* ─── Links desktop ─────────────────────────────────────────────────────── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: var(--text-muted);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
    white-space: nowrap;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  /* ─── Acciones (CTA + burger) ───────────────────────────────────────────── */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  /* ─── Botón CTA ─────────────────────────────────────────────────────────── */
  .btn-cta {
    display: flex;
    align-items: center;
    gap: 6px;
    background: var(--accent);
    color: #000;
    font-weight: 600;
    font-size: 13px;
    padding: 10px 20px;
    border-radius: var(--radius);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background  0.2s ease,
      transform   0.2s ease,
      box-shadow  0.2s ease;
  }

  .btn-cta:hover {
    background: var(--accent-dim);
    transform: translateY(-1px);
    box-shadow: 0 4px 20px rgba(179, 136, 255, 0.3);
  }

  .btn-cta:active {
    transform: translateY(0);
  }

  .btn-cta svg {
    flex-shrink: 0;
  }

  /* ─── Burger ────────────────────────────────────────────────────────────── */
  .nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    padding: 11px;
    background: transparent;
    border: none;
    cursor: pointer;
    border-radius: 8px;
    transition: background 0.2s ease;
  }

  .nav-burger:hover {
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition:
      transform  0.35s cubic-bezier(0.4, 0, 0.2, 1),
      opacity    0.25s ease,
      background 0.2s ease;
    transform-origin: center;
  }

  /* Burger → X cuando .open */
  .nav-burger.open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-burger.open span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .nav-burger.open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ─── Mobile menu ───────────────────────────────────────────────────────── */
  .nav-mobile {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--bg);
    background: color-mix(in srgb, var(--bg) 97%, transparent);
    -webkit-backdrop-filter: blur(20px);
    backdrop-filter: blur(20px);
    padding: 88px 32px 40px;
    display: flex;
    flex-direction: column;
    gap: 40px;
    transform: translateY(-100%);
    visibility: hidden;
    transition:
      transform   0.4s cubic-bezier(0.4, 0, 0.2, 1),
      visibility  0s   linear 0.4s;
    pointer-events: none;
    z-index: 99;
  }

  .nav-mobile.open {
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
    transition:
      transform   0.4s cubic-bezier(0.4, 0, 0.2, 1),
      visibility  0s   linear 0s;
  }

  .nav-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-link {
    display: block;
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    color: var(--text-muted);
    text-decoration: none;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    transition: color 0.2s ease, padding-left 0.2s ease;
    letter-spacing: -0.02em;
  }

  .mobile-link:hover {
    color: var(--text);
    padding-left: 8px;
  }

  .mobile-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--accent);
    color: #000;
    font-weight: 700;
    font-size: 16px;
    padding: 16px 28px;
    border-radius: var(--radius);
    text-decoration: none;
    transition: background 0.2s ease;
    align-self: flex-start;
  }

  .mobile-cta:hover {
    background: var(--accent-dim);
  }

  /* ─── Responsive ────────────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .nav-links,
    .btn-cta {
      display: none;
    }

    .nav-burger {
      display: flex;
    }
  }

  @media (min-width: 768px) {
    .nav-burger,
    .nav-mobile {
      display: none !important;
    }
  }

  /* ─── Reduced motion ────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    nav,
    .nav-burger span,
    .nav-mobile,
    .btn-cta,
    .mobile-link {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    var nav      = document.getElementById('nav');
    var burger   = nav.querySelector('.nav-burger');
    var mobile   = document.getElementById('navMobile');
    var links    = mobile.querySelectorAll('.mobile-link, .mobile-cta');
    var isOpen   = false;

    /* ── Scroll → clase .scrolled ──────────────────────────────────────── */
    function onScroll() {
      if (window.scrollY > 50) {
        nav.classList.add('scrolled');
      } else {
        nav.classList.remove('scrolled');
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    // Estado inicial por si la página carga desplazada
    onScroll();

    /* ── Burger toggle ──────────────────────────────────────────────────── */
    function openMenu() {
      isOpen = true;
      burger.classList.add('open');
      mobile.classList.add('open');
      mobile.removeAttribute('inert');
      burger.setAttribute('aria-expanded', 'true');
      mobile.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      var firstLink = mobile.querySelector('.mobile-link');
      if (firstLink) { firstLink.focus(); }
    }

    function closeMenu() {
      isOpen = false;
      burger.classList.remove('open');
      mobile.classList.remove('open');
      mobile.setAttribute('inert', '');
      burger.setAttribute('aria-expanded', 'false');
      mobile.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      burger.focus();
    }

    burger.addEventListener('click', function () {
      if (isOpen) { closeMenu(); } else { openMenu(); }
    });

    /* ── Click en links del mobile menu → cerrar ─────────────────────── */
    links.forEach(function (link) {
      link.addEventListener('click', closeMenu);
    });

    /* ── ESC cierra el menú ─────────────────────────────────────────── */
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen) { closeMenu(); }
    });

    /* ── Focus trap dentro del dialog ──────────────────────────────── */
    mobile.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab' || !isOpen) { return; }
      var focusable = Array.prototype.slice.call(
        mobile.querySelectorAll('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')
      );
      if (!focusable.length) { return; }
      var first = focusable[0];
      var last  = focusable[focusable.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first) { e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last)  { e.preventDefault(); first.focus(); }
      }
    });
  })();
</script>
