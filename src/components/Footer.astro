---
const WA_URL =
  "https://wa.me/573046565684?text=Hola%2C%20quiero%20una%20cotizaci%C3%B3n%20para%20mi%20sitio%20web";

const navLinks = [
  { href: "#inicio",    label: "Inicio" },
  { href: "#proyectos", label: "Proyectos" },
  { href: "#servicios", label: "Servicios" },
  { href: "#proceso",   label: "Proceso" },
  { href: "#precios",   label: "Precios" },
  { href: "#contacto",  label: "Contacto" },
];
---

<footer class="footer" id="footer" aria-label="Pie de página">
  <div class="wrap">

    <div class="footer-main">

      <!-- ── Marca ──────────────────────────────────────────────────────────── -->
      <div class="footer-brand">
        <a href="#inicio" class="footer-logo">
          WebTure<span class="footer-dot">.</span>
        </a>
        <p class="footer-tagline">
          Sitios web para negocios<br />locales en Colombia.
        </p>
        <span class="footer-location">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          Armenia, Quindío · Colombia
        </span>
        <a
          href={WA_URL}
          class="footer-wa"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Escribir por WhatsApp"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Hablemos por WhatsApp
        </a>
      </div>

      <!-- ── Navegación ─────────────────────────────────────────────────────── -->
      <nav class="footer-nav" aria-label="Navegación del pie de página">
        <span class="footer-nav-title">Navegación</span>
        <ul role="list">
          {navLinks.map((link) => (
            <li>
              <a href={link.href} class="footer-nav-link">{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- ── Contacto ───────────────────────────────────────────────────────── -->
      <div class="footer-contact">
        <span class="footer-nav-title">Contacto</span>
        <a href="mailto:hola@webture.co" class="footer-contact-link">
          hola@webture.co
        </a>
        <a href="tel:+573046565684" class="footer-contact-link">
          +57 304 656 5684
        </a>
        <span class="footer-hours">Lun–Vie · 8am–6pm COT</span>
      </div>

    </div>

    <!-- ── Barra inferior ─────────────────────────────────────────────────── -->
    <div class="footer-bottom">
      <span class="footer-copy">© 2025 WebTure · Armenia, Quindío, Colombia</span>
      <a href="mailto:hola@webture.co" class="footer-email-small">hola@webture.co</a>
    </div>

  </div>
</footer>

<style>
  /* ─── Sección ────────────────────────────────────────────────────────────── */
  .footer {
    padding: 80px 0 0;
    position: sticky;
    top: 0;
    z-index: 11;
    background: var(--bg);
    border-radius: 24px 24px 0 0;
    box-shadow: 0 -28px 72px rgba(0, 0, 0, 0.55);
  }

  /* Línea degradada superior */
  .footer::before {
    content: "";
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(600px, 80%);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-bright), transparent);
  }

  /* ─── Grid principal ─────────────────────────────────────────────────────── */
  .footer-main {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 64px;
    padding-bottom: 56px;
  }

  /* ─── Marca ──────────────────────────────────────────────────────────────── */
  .footer-logo {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 26px;
    letter-spacing: -0.04em;
    color: var(--text);
    text-decoration: none;
    margin-bottom: 14px;
    transition: opacity 0.2s ease;
  }

  .footer-logo:hover { opacity: 0.8; }

  .footer-dot {
    color: var(--accent);
    text-shadow: 0 0 16px rgba(179, 136, 255, 0.5);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0;
  }

  .footer-tagline {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.65;
    margin-bottom: 16px;
  }

  .footer-location {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: 0.04em;
    margin-bottom: 28px;
  }

  .footer-wa {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    min-height: 44px;
    background: rgba(37, 211, 102, 0.08);
    border: 1px solid rgba(37, 211, 102, 0.2);
    border-radius: var(--radius);
    font-size: 13px;
    font-weight: 600;
    color: #25D366;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
    white-space: nowrap;
  }

  @media (hover: hover) {
    .footer-wa:hover {
      background: rgba(37, 211, 102, 0.14);
      border-color: rgba(37, 211, 102, 0.35);
    }
  }

  /* ─── Navegación ─────────────────────────────────────────────────────────── */
  .footer-nav-title {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 20px;
  }

  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .footer-nav-link {
    display: inline-block;
    font-size: 14px;
    color: var(--text-muted);
    text-decoration: none;
    padding: 5px 0;
    min-height: 44px;
    display: flex;
    align-items: center;
    transition: color 0.2s ease;
    min-height: auto;
    padding: 4px 0;
  }

  @media (hover: hover) {
    .footer-nav-link:hover { color: var(--text); }
  }

  /* ─── Columna contacto ───────────────────────────────────────────────────── */
  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .footer-contact-link {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    text-decoration: none;
    padding: 4px 0;
    transition: color 0.2s ease;
    margin-bottom: 4px;
  }

  @media (hover: hover) {
    .footer-contact-link:hover { color: var(--accent); }
  }

  .footer-hours {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    margin-top: 12px;
    letter-spacing: 0.03em;
  }

  /* ─── Barra inferior ─────────────────────────────────────────────────────── */
  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 0 28px;
    border-top: 1px solid var(--border);
    gap: 16px;
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: 0.03em;
  }

  .footer-email-small {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-dim);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  @media (hover: hover) {
    .footer-email-small:hover { color: var(--accent); }
  }

  /* ─── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 959px) {
    .footer-main {
      grid-template-columns: 1fr 1fr;
      gap: 48px;
    }

    .footer-brand {
      grid-column: 1 / -1;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 24px;
    }

    .footer-logo { display: block; width: 100%; margin-bottom: 0; }
    .footer-tagline { margin-bottom: 0; }
    .footer-location { margin-bottom: 0; }
  }

  @media (max-width: 767px) {
    .footer {
      padding: 60px 0 0;
      position: relative;
      border-radius: 0;
      box-shadow: none;
    }

    .footer-main {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .footer-brand {
      flex-direction: column;
      gap: 12px;
    }

    .footer-logo { margin-bottom: 2px; }
    .footer-tagline { margin-bottom: 4px; }
    .footer-location { margin-bottom: 12px; }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  }

  /* ─── Reduced motion ─────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .footer-logo,
    .footer-wa,
    .footer-nav-link,
    .footer-contact-link,
    .footer-email-small {
      transition: none;
    }
  }
</style>
