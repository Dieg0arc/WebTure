---
const WA_URL = 'https://wa.me/573046565684?text=Hola%2C%20me%20interesa%20saber%20más%20sobre%20el%20proceso%20de%20WebTure';

const steps = [
  {
    num:   "01",
    badge: "Día 1",
    title: "Consulta",
    desc:  "Me cuentas de tu negocio, tus clientes y lo que necesitas. En 30 minutos tenemos todo claro.",
    featured: false,
  },
  {
    num:   "02",
    badge: "Día 2",
    title: "Diseño",
    desc:  "Creo el diseño visual a la medida de tu marca. Ves la propuesta antes de escribir una sola línea de código.",
    featured: false,
  },
  {
    num:   "03",
    badge: "Día 3",
    title: "Desarrollo",
    desc:  "Construyo el sitio con código limpio y optimizado. Rápido, accesible y listo para Google.",
    featured: false,
  },
  {
    num:   "04",
    badge: "Día 4",
    title: "Entrega",
    desc:  "Tu sitio live, en tu dominio, con todas las instrucciones para manejarlo. Listo para recibir clientes.",
    featured: true,
  },
];
---

<div class="process-outer" id="processOuter">
<section id="proceso" class="process" aria-label="El proceso de trabajo">
  <div class="wrap">
    <div class="process-wrap">

      <!-- ── Columna izquierda: texto + indicadores ──────────────────────── -->
      <div class="process-content">

        <header class="process-header">
          <span class="process-label">El proceso</span>
          <h2 class="process-title split-title">
            De idea a sitio <em class="accent-italic">en 4 días.</em>
          </h2>
          <p class="process-sub">
            Sin reuniones interminables. Sin sorpresas.<br>
            Un proceso claro de principio a fin.
          </p>
        </header>

        <!-- ── Vista mobile: tipografía editorial ──────────────────────── -->
        <div class="proc-mobile-view" id="procMobileView">
          <p class="proc-mobile-num" id="procMobileNum" aria-hidden="true">{steps[0].num}</p>
          <div class="proc-mobile-step" aria-live="polite">
            <h3 class="proc-mobile-title" id="procMobileTitle">{steps[0].title}</h3>
            <p class="proc-mobile-desc" id="procMobileDesc">{steps[0].desc}</p>
          </div>
          <div class="proc-dots" role="list" aria-label="Pasos del proceso">
            {steps.map((step, i) => (
              <button
                class={`proc-dot${i === 0 ? ' proc-dot--active' : ''}`}
                data-dot={String(i)}
                aria-label={`Ir al paso ${i + 1}: ${step.title}`}
                type="button"
              />
            ))}
          </div>
          <div class="proc-scroll-hint" aria-hidden="true" id="procScrollHint">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 5v14M5 12l7 7 7-7"/>
            </svg>
            scroll
          </div>
        </div>

        <div class="process-steps">
          {steps.map((step, i) => (
            <button
              class={`proc-step${i === 0 ? ' proc-step--active' : ''}`}
              data-step={String(i)}
              aria-label={`Ver paso ${i + 1}: ${step.title}`}
              type="button"
            >
              <span class="proc-step-num">{step.num}</span>
              <span class="proc-step-info">
                <span class="proc-step-title">{step.title}</span>
                <span class="proc-step-badge">{step.badge}</span>
              </span>
              <svg class="proc-step-arrow" width="14" height="14" viewBox="0 0 14 14"
                   fill="none" aria-hidden="true">
                <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.8"
                      stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          ))}
        </div>

        <div class="process-cta">
          <a
            href={WA_URL}
            class="btn-primary"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Comenzar ahora por WhatsApp"
          >
            Comenzar ahora
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>

      </div>

      <!-- ── Columna derecha: card stack ────────────────────────────────── -->
      <div class="process-stack-outer" id="processStackOuter">
        <div class="process-stack" id="processStack">

          {steps.map((step, i) => (
            <article
              class={`stack-card${step.featured ? ' stack-card--hl' : ''}`}
              data-step={String(i)}
              aria-label={`Paso ${i + 1}: ${step.title}`}
              aria-hidden={i !== 0 ? 'true' : 'false'}
            >
              <div class="sc-progress" aria-hidden="true">
                <div class="sc-progress-fill"></div>
              </div>
              <span class="sc-bgnum" aria-hidden="true">{step.num}</span>

              <div class="sc-top">
                <div class="sc-icon" aria-hidden="true">
                  {i === 0 && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
                    </svg>
                  )}
                  {i === 1 && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <path d="M3 9h18M9 21V9"/>
                    </svg>
                  )}
                  {i === 2 && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="16 18 22 12 16 6"/>
                      <polyline points="8 6 2 12 8 18"/>
                    </svg>
                  )}
                  {i === 3 && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.5"
                         stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                  )}
                </div>
                <span class="sc-counter" aria-hidden="true">Paso {i + 1} de {steps.length}</span>
                <span class={`sc-badge${step.featured ? ' sc-badge--hl' : ''}`}>
                  {step.badge}
                </span>
              </div>

              <div class="sc-body">
                <h3 class="sc-title">{step.title}</h3>
                <p class="sc-desc">{step.desc}</p>
              </div>
            </article>
          ))}
        </div>
        <!-- Hint de scroll — solo visible en mobile, desaparece al primer avance -->
        <div class="proc-scroll-hint" aria-hidden="true" id="procScrollHint">
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2.5"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12l7 7 7-7"/>
          </svg>
          scroll
        </div>
      </div>

    </div>
  </div>
</section>
</div>

<style>
/* ── Sección (GSAP pin la fija en desktop) ───────────────────────────────── */
.process {
  padding: 120px 0;
  background: var(--bg);
  position: relative;
  z-index: 8;
  border-radius: 24px 24px 0 0;
  box-shadow: 0 -28px 72px rgba(0,0,0,0.55);
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 100svh;
}

.process::before {
  content: "";
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: min(600px, 80%);
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--border-bright), transparent);
}

/* ── Grid 2 columnas ─────────────────────────────────────────────────────── */
.process-wrap {
  display: grid;
  grid-template-columns: 1fr 540px;
  gap: 72px;
  align-items: center;
}

/* ── Columna izquierda ───────────────────────────────────────────────────── */
.process-content {
  display: flex;
  flex-direction: column;
  gap: 36px;
}

.process-header {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.process-label {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 12px;
}

.process-title {
  font-family: var(--font-display);
  font-size: clamp(30px, 3vw, 48px);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.04em;
  color: var(--text);
  margin-bottom: 14px;
}

.process-sub {
  font-size: 16px;
  color: var(--text-muted);
  line-height: 1.7;
}

/* ── Indicadores de paso ─────────────────────────────────────────────────── */
.process-steps {
  display: flex;
  flex-direction: column;
  gap: 4px;
  width: 100%;
}

.proc-step {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  min-height: 44px;
  border-radius: 10px;
  border: 1px solid transparent;
  background: transparent;
  cursor: pointer;
  text-align: left;
  width: 100%;
  font-family: var(--font-body);
  transition: background 0.2s ease, border-color 0.2s ease;
}

@media (hover: hover) {
  .proc-step:hover {
    background: rgba(179,136,255,0.05);
    border-color: var(--border);
  }
}

.proc-step:active {
  background: rgba(179,136,255,0.1);
}

.proc-step--active {
  background: rgba(179,136,255,0.08);
  border-color: rgba(179,136,255,0.2);
}

.proc-step-num {
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--text-dim);
  letter-spacing: 0.08em;
  flex-shrink: 0;
  width: 22px;
  transition: color 0.2s;
}

.proc-step--active .proc-step-num {
  color: var(--accent);
}

.proc-step-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 1px;
  min-width: 0;
}

.proc-step-title {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: var(--text-muted);
  line-height: 1.3;
  transition: color 0.2s;
}

.proc-step--active .proc-step-title {
  color: var(--text);
}

.proc-step-badge {
  display: block;
  font-family: var(--font-mono);
  font-size: 10px;
  color: var(--text-dim);
  letter-spacing: 0.05em;
  transition: color 0.2s;
}

.proc-step--active .proc-step-badge {
  color: var(--accent);
}

.proc-step-arrow {
  flex-shrink: 0;
  color: var(--accent);
  opacity: 0;
  transform: translateX(-6px);
  transition: opacity 0.2s, transform 0.2s;
}

.proc-step--active .proc-step-arrow,
.proc-step:hover .proc-step-arrow {
  opacity: 1;
  transform: translateX(0);
}

/* ── CTA ─────────────────────────────────────────────────────────────────── */
.process-cta {
  display: flex;
  align-items: center;
}

/* ── Columna derecha: contenedor del stack ───────────────────────────────── */
/* Dimensiones explícitas: card (380×264) + espacio para 3 cards de fondo   */
/* Fondo superior: 3 × 30px = 90px   Derecha: 3 × 53px = 159px             */
.process-stack-outer {
  position: relative;
  width: 540px;
  height: 356px;   /* 264 card + 90 padding top + 2px margen */
  flex-shrink: 0;
}

/* El stack vive en la esquina inferior-izquierda del outer */
.process-stack {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 380px;
  height: 264px;
}

/* ── Cards del stack ─────────────────────────────────────────────────────── */
.stack-card {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: var(--surface);
  border: 1px solid var(--border-bright);
  border-radius: var(--radius-lg);
  padding: 26px 24px 22px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: 14px;
  cursor: pointer;
  /* GSAP controla opacity y transform — sin estado inicial visible */
  will-change: transform, opacity;
}

.stack-card--hl {
  border-color: rgba(179,136,255,0.3);
  background: var(--surface-2);
}

.stack-card--hl::after {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--accent), transparent);
  opacity: 0.6;
}

/* ── Número de fondo ─────────────────────────────────────────────────────── */
.sc-bgnum {
  position: absolute;
  bottom: -10px;
  right: 14px;
  font-family: var(--font-display);
  font-size: 96px;
  font-weight: 800;
  line-height: 1;
  color: var(--text);
  opacity: 0.04;
  pointer-events: none;
  user-select: none;
  letter-spacing: -0.05em;
}

.stack-card--hl .sc-bgnum {
  opacity: 0.07;
  color: var(--accent);
}

/* ── Header interno ──────────────────────────────────────────────────────── */
.sc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.sc-icon {
  width: 42px;
  height: 42px;
  border-radius: 11px;
  background: var(--accent-glow-soft);
  border: 1px solid var(--border-bright);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--accent);
  flex-shrink: 0;
}

.stack-card--hl .sc-icon {
  background: var(--accent-glow);
  border-color: rgba(179,136,255,0.3);
}

.sc-badge {
  font-family: var(--font-mono);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-muted);
  background: var(--surface-2);
  border: 1px solid var(--border-bright);
  border-radius: 20px;
  padding: 4px 11px;
}

.sc-badge--hl {
  color: #000;
  background: var(--accent);
  border-color: var(--accent);
}

/* ── Cuerpo ──────────────────────────────────────────────────────────────── */
.sc-body {
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
  position: relative;
  z-index: 1;
}

.sc-title {
  font-family: var(--font-display);
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text);
  line-height: 1.2;
  margin: 0;
}

.sc-desc {
  font-size: 14px;
  color: var(--text-muted);
  line-height: 1.65;
  margin: 0;
}

/* ── Scroll hint mobile ──────────────────────────────────────────────────── */
.proc-scroll-hint {
  display: none;
}

@keyframes hintBounce {
  0%, 100% { opacity: 0.4; transform: translateY(0); }
  50%       { opacity: 0.85; transform: translateY(5px); }
}

/* ── Barra de progreso mobile ────────────────────────────────────────────── */
.sc-progress {
  display: none;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: rgba(255, 255, 255, 0.06);
  overflow: hidden;
}

.sc-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--accent), #d4b8ff);
  width: 25%;
  border-radius: 0 2px 2px 0;
  transition: width 0.48s ease;
}

.sc-counter {
  display: none;
  font-family: var(--font-mono);
  font-size: 11px;
  letter-spacing: 0.08em;
  color: var(--text-dim);
}

/* ── Vista tipográfica mobile ─────────────────────────────────────────────── */
.proc-mobile-view {
  display: none;
  flex-direction: column;
}

.proc-mobile-num {
  font-family: var(--font-display);
  font-size: clamp(88px, 28vw, 120px);
  font-weight: 800;
  letter-spacing: -0.06em;
  line-height: 0.82;
  background: linear-gradient(120deg, var(--accent) 0%, #d4b8ff 60%, #f0e6ff 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  display: block;
  margin: 0 0 20px;
  user-select: none;
}

.proc-mobile-step {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.proc-mobile-title {
  font-family: var(--font-display);
  font-size: 26px;
  font-weight: 700;
  letter-spacing: -0.03em;
  color: var(--text);
  line-height: 1.15;
  margin: 0;
}

.proc-mobile-desc {
  font-size: 15px;
  color: var(--text-muted);
  line-height: 1.65;
  margin: 0;
}

.proc-dots {
  display: flex;
  gap: 6px;
  align-items: center;
  margin-top: 28px;
}

.proc-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: none;
  cursor: pointer;
  padding: 0;
  position: relative;
  transition: background 0.3s ease, width 0.3s ease, border-radius 0.3s ease;
}

.proc-dot::before {
  content: '';
  position: absolute;
  inset: -19px;
}

.proc-dot--active {
  background: var(--accent);
  width: 22px;
  border-radius: 3px;
}

/* ── Responsive ──────────────────────────────────────────────────────────── */
@media (max-width: 1100px) {
  .process-wrap {
    grid-template-columns: 1fr 460px;
    gap: 56px;
  }

  .process-stack-outer {
    width: 460px;
  }

  .process-stack {
    width: 320px;
    height: 240px;
  }

  .stack-card {
    width: 100%;
    height: 100%;
  }
}

@media (max-width: 959px) {
  .process-wrap {
    grid-template-columns: 1fr;
    gap: 52px;
  }

  .process-stack-outer {
    width: 100%;
    max-width: 480px;
    height: 300px;
  }

  .process-stack {
    width: 320px;
    height: 220px;
  }
}

@media (max-width: 767px) {
  .process {
    position: relative;
    border-radius: 0;
    box-shadow: none;
    padding: 60px 0;
  }

  /* Ocultar stack de cards y elementos solo de desktop */
  .process-stack-outer { display: none; }
  .process-steps       { display: none; }
  .process-title       { display: none; }
  .process-sub         { display: none; }

  /* Mostrar vista tipográfica */
  .proc-mobile-view { display: flex; }

  /* Ajustar espaciado del contenido */
  .process-content { gap: 0; }
  .process-header  { margin-bottom: 24px; }
  .process-cta     { margin-top: 32px; }

  /* Scroll hint */
  .proc-scroll-hint {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 20px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
    pointer-events: none;
    animation: hintBounce 1.8s ease-in-out infinite;
    transition: opacity 0.4s ease;
  }

  .proc-scroll-hint.hidden {
    opacity: 0;
    animation: none;
  }
}

/* ── Reduced motion ──────────────────────────────────────────────────────── */
@media (prefers-reduced-motion: reduce) {
  .proc-step,
  .proc-step-arrow,
  .proc-dot { transition: none; }

  /* Sin animación: mostrar solo la primera card estática */
  .stack-card {
    transform: none !important;
    skewX: 0 !important;
  }
  .stack-card:not(:first-child) {
    display: none;
  }
  .stack-card:first-child {
    opacity: 1 !important;
  }
}
</style>

<script type="module">
  function initProcess() {
    const gsap           = window.gsap;
    const ScrollTrigger  = window.ScrollTrigger;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!gsap || !ScrollTrigger) return;

    const outerEl    = document.getElementById('processOuter');
    const stackEl    = document.getElementById('processStack');
    if (!outerEl || !stackEl) return;
    const cards      = Array.from(stackEl.querySelectorAll('.stack-card'));
    const indicators = Array.from(document.querySelectorAll('.proc-step'));
    if (!cards.length) return;

    const STEPS     = cards.length;
    let currentStep = -1;

    /* Datos de cada paso leídos desde las cards del DOM */
    const stepData = cards.map(card => ({
      num:   card.querySelector('.sc-bgnum').textContent.trim(),
      title: card.querySelector('.sc-title').textContent.trim(),
      desc:  card.querySelector('.sc-desc').textContent.trim(),
    }));

    /* Elementos de la vista tipográfica mobile */
    const mobileView  = document.getElementById('procMobileView');
    const mobileNum   = document.getElementById('procMobileNum');
    const mobileTitle = document.getElementById('procMobileTitle');
    const mobileDesc  = document.getElementById('procMobileDesc');
    const mobileDots  = Array.from(document.querySelectorAll('.proc-dot'));

    /* ── Posición GSAP de una card según el paso activo ── */
    function cardPos(activeStep, cardIndex) {
      const w     = window.innerWidth;
      const depth = (cardIndex - activeStep + STEPS) % STEPS;

      if (w <= 767) {
        /* Mobile: cross-fade — solo la card activa es visible */
        return {
          x: 0, y: 0, scale: 1,
          opacity: depth === 0 ? 1 : 0,
          zIndex:  STEPS - depth,
          skewX:   0,
        };
      }

      const CX = w <= 1100 ? 34 : 46;
      const CY = w <= 1100 ? 20 : 27;
      return {
        x:       depth * CX,
        y:      -(depth * CY),
        scale:   1 - depth * 0.04,
        opacity: depth === 0 ? 1 : Math.max(0.18, 1 - depth * 0.26),
        zIndex:  STEPS - depth,
        skewX:  -6,
      };
    }

    /* ── Transición animada al paso indicado ── */
    function applyStep(index, animate = true) {
      if (index === currentStep) return;
      currentStep = index;
      const dur      = (animate && !prefersReduced) ? 0.48 : 0;
      const isMobile = window.innerWidth <= 767;

      if (isMobile) {
        /* Mobile: actualizar tipografía con fade + leve desplazamiento */
        if (animate && !prefersReduced && mobileNum) {
          gsap.to([mobileNum, mobileTitle, mobileDesc], {
            opacity: 0, y: -6, duration: 0.18, ease: 'power2.in',
            onComplete() {
              mobileNum.textContent   = stepData[index].num;
              mobileTitle.textContent = stepData[index].title;
              mobileDesc.textContent  = stepData[index].desc;
              gsap.fromTo(
                [mobileNum, mobileTitle, mobileDesc],
                { opacity: 0, y: 10 },
                { opacity: 1, y: 0, duration: 0.3, ease: 'power2.out', stagger: 0.05 }
              );
            },
          });
        } else if (mobileNum) {
          mobileNum.textContent   = stepData[index].num;
          mobileTitle.textContent = stepData[index].title;
          mobileDesc.textContent  = stepData[index].desc;
        }
        mobileDots.forEach((dot, i) => dot.classList.toggle('proc-dot--active', i === index));
        const hint = document.getElementById('procScrollHint');
        if (hint && !hint.classList.contains('hidden')) hint.classList.add('hidden');
      } else {
        /* Desktop: animación original del stack */
        cards.forEach((card, i) => {
          const p = cardPos(index, i);
          gsap.to(card, {
            x: p.x, y: p.y, scale: p.scale,
            opacity: p.opacity, zIndex: p.zIndex, skewX: p.skewX,
            duration: dur,
            ease: i === index ? 'back.out(1.5)' : 'power2.out',
          });
        });
      }

      indicators.forEach((ind, i) => {
        ind.classList.toggle('proc-step--active', i === index);
        ind.setAttribute('aria-current', String(i === index));
      });
      cards.forEach((card, i) =>
        card.setAttribute('aria-hidden', String(i !== index))
      );
    }

    /* ── Animación de entrada ──────────────────────────────────────────────── */
    function runEntrance() {
      const isMobile = window.innerWidth <= 767;

      if (isMobile) {
        /* Mobile: animar la vista tipográfica */
        if (!prefersReduced && mobileView) {
          gsap.fromTo(
            mobileView,
            { opacity: 0, y: 20 },
            { opacity: 1, y: 0, duration: 0.65, ease: 'power3.out' }
          );
        }
      } else {
        /* Desktop: cards suben a su posición en el stack */
        cards.forEach((card, i) => {
          const p = cardPos(0, i);
          gsap.set(card, { x: p.x, y: p.y + 64, scale: p.scale, opacity: 0, zIndex: p.zIndex, skewX: p.skewX });
        });
        if (!prefersReduced) {
          cards.forEach((card, i) => {
            const p = cardPos(0, i);
            gsap.to(card, { y: p.y, opacity: p.opacity, duration: 0.65, ease: 'back.out(1.4)', delay: 0.06 + i * 0.08 });
          });
        } else {
          cards.forEach((card, i) => gsap.set(card, cardPos(0, i)));
        }
      }

      currentStep = 0;
      indicators.forEach((ind, i) => {
        ind.classList.toggle('proc-step--active', i === 0);
        ind.setAttribute('aria-current', String(i === 0));
      });
      mobileDots.forEach((dot, i) => dot.classList.toggle('proc-dot--active', i === 0));
    }

    gsap.set(cards, { opacity: 0 });

    let entered = false;

    ScrollTrigger.create({
      id:      'processTrigger',
      trigger: '.process',
      pin:     true,
      start:   'top top',
      end:     `+=${(STEPS - 1) * window.innerHeight}`,
      onEnter() {
        if (entered) return;
        entered = true;
        runEntrance();
      },
      onEnterBack() {
        if (!entered) { entered = true; runEntrance(); }
      },
      onUpdate(self) {
        if (!entered) return;
        const step = Math.min(STEPS - 1, Math.round(self.progress * (STEPS - 1)));
        applyStep(step);
      },
    });

    /* Click en indicador de desktop → scroll al paso */
    indicators.forEach((ind, i) => {
      ind.addEventListener('click', () => {
        const trigger = ScrollTrigger.getById('processTrigger');
        if (!trigger) { applyStep(i); return; }
        const progress = i / (STEPS - 1);
        const target   = trigger.start + (trigger.end - trigger.start) * progress;
        const lenis    = window.__lenis;
        if (lenis) lenis.scrollTo(target, { duration: 0.6 });
        else window.scrollTo({ top: target, behavior: 'smooth' });
      });
    });

    /* Tap en dot mobile → scroll al paso */
    mobileDots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        const trigger = ScrollTrigger.getById('processTrigger');
        if (!trigger) { applyStep(i); return; }
        const progress = i / (STEPS - 1);
        const target   = trigger.start + (trigger.end - trigger.start) * progress;
        const lenis    = window.__lenis;
        if (lenis) lenis.scrollTo(target, { duration: 0.6 });
        else window.scrollTo({ top: target, behavior: 'smooth' });
      });
    });

    /* ── Animaciones de entrada del texto ── */
    gsap.fromTo('.process-header', { opacity: 0, y: 24 }, {
      opacity: 1, y: 0, duration: 0.65, ease: 'power3.out',
      scrollTrigger: { trigger: '.process', start: 'top 80%', once: true },
    });
    gsap.fromTo('.process-steps', { opacity: 0, y: 18 }, {
      opacity: 1, y: 0, duration: 0.55, ease: 'power3.out', delay: 0.14,
      scrollTrigger: { trigger: '.process', start: 'top 80%', once: true },
    });
    gsap.fromTo('.process-cta', { opacity: 0, y: 14 }, {
      opacity: 1, y: 0, duration: 0.5, ease: 'power3.out', delay: 0.26,
      scrollTrigger: { trigger: '.process', start: 'top 80%', once: true },
    });
  }

  if (document.readyState === 'complete') {
    initProcess();
  } else {
    window.addEventListener('load', initProcess, { once: true });
  }

  /* Fuentes se cargan de forma lazy (media="print" trick) — refrescar
     posiciones de ScrollTrigger una vez que el layout refluje con fuentes reales */
  document.fonts.ready.then(() => {
    if (window.ScrollTrigger) window.ScrollTrigger.refresh();
  });
</script>
