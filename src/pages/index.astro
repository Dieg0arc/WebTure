---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import TechBand from '../components/TechBand.astro';
import ScrollStory from '../components/ScrollStory.astro';
import Projects from '../components/Projects.astro';
import Services from '../components/Services.astro';
import Metrics from '../components/Metrics.astro';
---

<Layout>
  <Navbar />
  <main id="main-content">
    <Hero />
    <TechBand />
    <ScrollStory />
    <Projects />
    <Services />
    <Metrics />
    <section id="proceso" aria-label="Proceso" style="padding: 60px 0; border-top: 1px solid var(--border);"></section>
    <section id="precios" aria-label="Precios" style="padding: 1px 0;"></section>
    <section id="contacto" aria-label="Contacto" style="padding: 1px 0;"></section>
  </main>
</Layout>
